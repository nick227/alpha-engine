# ==============================================================================
# Alpha Engine — Railway Deployment Environment Variables
# ==============================================================================

# Network Binding
INTERNAL_READ_HOST=0.0.0.0
PORT=8090

# Persistence & Storage
# Attach a 10-20 GB Railway Volume mounted at /data
ALPHA_DB_PATH=/data/alpha.db

# Authentication Key (must match trading-platform server INTERNAL_READ_KEY)
INTERNAL_READ_KEY=replace-with-a-64-hex-char-secret

# Safety Guardrails
ALLOW_LIVE_TRADING=false

# Daily Pipeline & Ingestion Settings
ALPHA_RANKING_SNAPSHOT_LOOKBACK_DAYS=7
ALPHA_RANKING_SNAPSHOT_MAX_TICKERS=50
ALPHA_REC_MAX_PER_SECTOR=2
ALPHA_REC_REPEAT_WINDOW_DAYS=3

# Python Optimization
PYTHONUNBUFFERED=1
